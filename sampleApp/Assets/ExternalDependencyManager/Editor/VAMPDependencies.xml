<?xml version="1.0" encoding="UTF-8"?>
<dependencies>
    <androidPackages>
        <androidPackage spec="com.google.android.gms:play-services-base:17.6.0"/>
        <androidPackage spec="androidx.multidex:multidex:2.0.1"/>
        <androidPackage spec="androidx.appcompat:appcompat:1.3.0"/>
        <!--VAMP-->
        <repositories>
            <repository>https://AdGeneration.github.io/VAMP-Android-SDK/repository</repository>
        </repositories>
        <androidPackage spec="jp.supership.vamp:vamp-sdk:5.3.9"/>
        <!--AppOpenAdManager サンプルのライフサイクル統合に必要 (Issue #51 PR-2)-->
        <androidPackage spec="androidx.lifecycle:lifecycle-process:[2.5.1,3.0.0)"/>
        <!--Adapters are pinned to the versions verified with this sample (Issue #76).-->
        <!--AdMob-->
        <androidPackage spec="jp.supership.vamp:vamp-admob-adapter:25.5.0"/>
        <!--AppLovin-->
        <androidPackage spec="jp.supership.vamp:vamp-applovin-adapter:13.6.400"/>
        <!--LINEAds-->
        <androidPackage spec="jp.supership.vamp:vamp-lineads-adapter:3.1.100"/>
        <!--maio-->
        <androidPackage spec="jp.supership.vamp:vamp-maio-adapter:2.0.900">
            <repositories>
                <repository>https://imobile-maio.github.io/maven</repository>
            </repositories>
        </androidPackage>
        <!--Pangle-->
        <androidPackage spec="jp.supership.vamp:vamp-pangle-adapter:8.3.401">
            <repositories>
                <repository>https://artifact.bytedance.com/repository/pangle</repository>
            </repositories>
        </androidPackage>
        <!--UnityAds: unity-ads を exclude しない (Unity 6 で NoClassDefFoundError になるため)。unity-ads 本体の版は adapter の依存を Gradle が解決する (Issue #60).-->
        <androidPackage spec="jp.supership.vamp:vamp-unityads-adapter:4.21.0"/>
    </androidPackages>
    <iosPods>
        <!--VAMP-->
        <iosPod name="VAMP-SDK" version="5.3.8"/>
        <!--Adapters are pinned to the versions verified with this sample (Issue #76).-->
        <!--AdMob-->
        <iosPod name="VAMPAdmobAdapter" version="13.11.0"/>
        <!--AppLovin-->
        <iosPod name="VAMPAppLovinAdapter" version="13.6.400"/>
        <!--LINEAds-->
        <iosPod name="VAMPLINEAdsAdapter" version="3.1.100"/>
        <!--maio-->
        <iosPod name="VAMPMaioAdapter" version="2.2.300"/>
        <!--Pangle-->
        <iosPod name="VAMPPangleAdapter" version="8.3.900"/>
        <!--UnityAds: keep exact to avoid version skew with the UnityAds integration used by this project.-->
        <iosPod name="VAMPUnityAdsAdapter" version="4.21.0"/>
    </iosPods>
</dependencies>
