<?xml version="1.0" encoding="UTF-8"?>
<dependencies>
    <androidPackages>
        <androidPackage spec="com.google.android.gms:play-services-base:17.6.0"/>
        <androidPackage spec="androidx.multidex:multidex:2.0.1"/>
        <androidPackage spec="androidx.appcompat:appcompat:1.3.0"/>
        <!--VAMP-->
        <repositories>
            <repository>https://AdGeneration.github.io/VAMP-Android-SDK/repository</repository>
        </repositories>
        <androidPackage spec="jp.supership.vamp:vamp-sdk:5.3.5"/>
        <!--AppOpenAdManager サンプルのライフサイクル統合に必要 (Issue #51 PR-2)-->
        <androidPackage spec="androidx.lifecycle:lifecycle-process:[2.5.1,3.0.0)"/>
        <!--Pin VAMP SDK to 5.3.5 and Pangle adapter to 7.9.10200 for App Open Ads support (Issue #51).-->
        <!--AdMob-->
        <androidPackage spec="jp.supership.vamp:vamp-admob-adapter:[24.9.0,25.0.0)"/>
        <!--AppLovin-->
        <androidPackage spec="jp.supership.vamp:vamp-applovin-adapter:[13.5.100,14.0.0)"/>
        <!--ironSource-->
        <androidPackage spec="jp.supership.vamp:vamp-ironsource-adapter:[8.11.1,9.0.0)">
            <repositories>
                <repository>https://android-sdk.is.com/</repository>
            </repositories>
        </androidPackage>
        <!--LINEAds-->
        <androidPackage spec="jp.supership.vamp:vamp-lineads-adapter:[3.0.100,4.0.0)"/>
        <!--maio-->
        <androidPackage spec="jp.supership.vamp:vamp-maio-adapter:[2.0.800,3.0.0)">
            <repositories>
                <repository>https://imobile-maio.github.io/maven</repository>
            </repositories>
        </androidPackage>
        <!--Pangle-->
        <androidPackage spec="jp.supership.vamp:vamp-pangle-adapter:[7.9.10200,8.0.0)">
            <repositories>
                <repository>https://artifact.bytedance.com/repository/pangle</repository>
            </repositories>
        </androidPackage>
        <!--UnityAds: exclude unity-ads を削除 (本質、Unity 6 で NoClassDefFoundError 解消のため) + adapter を 4.16.600 へ bump (副次、新版 unity-ads を Gradle resolve に委ねる) (Issue #60).-->
        <androidPackage spec="jp.supership.vamp:vamp-unityads-adapter:4.16.600"/>
    </androidPackages>
    <iosPods>
        <!--VAMP-->
        <iosPod name="VAMP-SDK" version="5.3.5"/>
        <!--Pin VAMP iOS SDK to 5.3.5 and Pangle adapter to 7.9.800 for App Open Ads support (Issue #51).-->
        <!--AdMob-->
        <iosPod name="VAMPAdmobAdapter" version="~> 13.0"/>
        <!--AppLovin-->
        <iosPod name="VAMPAppLovinAdapter" version="~> 13.5"/>
        <!--ironSource-->
        <iosPod name="VAMPIronSourceAdapter" version="~> 8.11"/>
        <!--LINEAds-->
        <iosPod name="VAMPLINEAdsAdapter" version="~> 3.0"/>
        <!--maio-->
        <iosPod name="VAMPMaioAdapter" version="~> 2.2"/>
        <!--Pangle-->
        <iosPod name="VAMPPangleAdapter" version="7.9.800"/>
        <!--UnityAds: keep exact to avoid version skew with the UnityAds integration used by this project.-->
        <iosPod name="VAMPUnityAdsAdapter" version="4.16.500"/>
    </iosPods>
</dependencies>
